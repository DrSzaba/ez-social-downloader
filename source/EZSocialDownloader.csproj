<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>EZSocialDownloader</AssemblyName>
    <RootNamespace>EZSocialDownloader</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>ref/Microsoft.Web.WebView2.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>ref/Microsoft.Web.WebView2.WinForms.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
